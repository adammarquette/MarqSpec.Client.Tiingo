<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>MarqSpec.Client.Tiingo</PackageId>
    <Authors>Adam Marquette</Authors>
    <Company>MarqSpec</Company>
    <Description>A .NET client library for the Tiingo news REST API — a data-only news source.</Description>
    <PackageTags>Tiingo;News;API;Client</PackageTags>
    <RepositoryUrl>https://github.com/adammarquette/MarqSpec.Client.Tiingo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/adammarquette/MarqSpec.Client.Tiingo</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
